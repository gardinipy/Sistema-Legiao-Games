# Modelo de configuração. Copie para .env e preencha:
#   cp .env.example .env
# O servidor não inicia sem as variáveis marcadas como obrigatórias.

# Porta do servidor
PORT=3000

# Quantos proxies reversos estão na frente do servidor (obrigatório decidir):
#  - 1 quando o Caddy (deploy padrão) está na frente do servidor;
#  - 0 quando o Node aceita conexões diretas da internet.
# Errar aqui deixa o bloqueio de força bruta burlável via header forjado.
TRUST_PROXY=1

# Acesso ao painel administrativo (obrigatórios).
# A senha precisa ter 10 caracteres ou mais — senhas curtas fazem o
# servidor recusar a iniciar. Gere uma forte, ex.:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_USER=
ADMIN_PASS=

# Chave de criptografia dos logins de cliente (obrigatória, 32+ caracteres)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Origem externa autorizada a chamar a API (opcional)
# ORIGIN=https://seudominio.com.br

# Pasta dos backups (opcional; padrão ./backups)
# BACKUP_DIR=/dados/legiao-backups

# Envio dos backups para a nuvem via rclone (opcional)
# Configure o remote com "rclone config" e coloque aqui o nome, ex.:
# RCLONE_REMOTE=gdrive:legiao-backups

# SO PARA TESTE LOCAL: permite senha de admin curta (NUNCA usar no servidor)
# PERMITIR_SENHA_FRACA=yes
